<Window x:Class="NPlugin.UI.Views.BatchPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="N Plugin — Пакетная печать" Width="680" Height="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="Листы" Grid.Row="0" Margin="0,0,0,8">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView ItemsSource="{Binding Sheets}" Grid.Row="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="36">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Checked}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Номер" DisplayMemberBinding="{Binding Number}" Width="110" />
                            <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding Name}" Width="*" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Обновить список" Command="{Binding RefreshCommand}" Margin="0,0,6,0" Padding="8,3" />
                    <Button Content="Выделить все" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" Padding="8,3" />
                    <Button Content="Снять выделение" Command="{Binding SelectNoneCommand}" Padding="8,3" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Папка:" VerticalAlignment="Center" Margin="0,0,6,4" />
            <TextBox Grid.Column="1" Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,4" />
            <Button Grid.Column="2" Content="..." Click="BrowseOutputClick" Width="30" Margin="0,0,0,4" />

            <TextBlock Grid.Row="1" Text="Шаблон имени:" VerticalAlignment="Center" Margin="0,0,6,4" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FileTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,4" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{}{Номер}-{Имя}" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,0,4" />

            <TextBlock Grid.Row="2" Text="Формат:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding Format}" Margin="0,0,6,0" Width="90" HorizontalAlignment="Left">
                <ComboBoxItem Content="PDF" />
                <ComboBoxItem Content="DWG" />
            </ComboBox>
            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                <CheckBox Content="Один файл" IsChecked="{Binding Combine}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <CheckBox Content="Открыть после" IsChecked="{Binding OpenAfter}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar Value="{Binding Progress}" Height="8" Margin="0,0,0,4" />
            <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Печать" Command="{Binding PrintCommand}" Padding="16,4" FontWeight="Bold" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
